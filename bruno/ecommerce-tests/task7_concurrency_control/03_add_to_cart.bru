meta {
  name: 3. Add Product to Cart
  type: http
}

post {
  url: {{base_url}}/cart/items
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{cc_token}}
  Content-Type: application/json
}

body:json {
  {
    "product_id": {{cc_product_id}},
    "quantity": 1
  }
}

script:post-response {
  if (res.body.data && res.body.data.id) {
    bru.setVar("cc_cart_item_id", res.body.data.id.toString());
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
