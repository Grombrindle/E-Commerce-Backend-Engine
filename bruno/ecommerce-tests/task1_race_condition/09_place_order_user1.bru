meta {
  name: Place Order (User 1)
  type: http
}

post {
  url: {{base_url}}/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token1}}
  Content-Type: application/json
}

body:json {
  {
    "shipping_address": {
      "name": "Race User 1",
      "street": "123 Test St",
      "city": "Test City",
      "country": "US",
      "zip": "10001"
    }
  }
}

script:post-response {
  const orderId = res.body.id || res.body.data?.id || res.body.order?.id;
  const orderStatus = res.body.status || res.body.data?.status;
  if (orderId) {
    bru.setVar("order_id", orderId.toString());
  }
  if (orderStatus) {
    bru.setVar("order_status", orderStatus);
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Order has an ID", function() {
    const body = res.getBody();
    expect(body.id || body.data?.id || body.order?.id).to.be.a("number");
  });
}
