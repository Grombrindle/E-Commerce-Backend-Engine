meta {
  name: ⚡ k6 Results Verification Checklist (CLI Required)
  type: http
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

script:pre-request {
  /*
   * ══════════════════════════════════════════════════════════════
   * k6 RESULTS VERIFICATION CHECKLIST
   * ══════════════════════════════════════════════════════════════
   *
   * After running k6, verify these things:
   *
   * ──── 1. k6 Console Output ────
   *   Look for:
   *     ✓ http_req_duration......: p(95) < 2000ms
   *     ✓ http_req_failed........: < 10%
   *     ✓ checkout_duration......: p(95) < 5000ms
   *     ✓ race_condition_successes: > 2
   *     ✓ race_condition_blocks..: > 6
   *
   * ──── 2. Check API response after k6 ────
   *   curl http://localhost:8080/api/v1/health/ready
   *   Expected: {"status":"healthy"} — system recovered
   *
   * ──── 3. Check queue depths after test ────
   *   docker compose exec redis redis-cli LLEN "queues:default"
   *   Expected: 0 (all jobs processed)
   *
   * ──── 4. Check for overselling ────
   *   docker compose exec app1 php artisan tinker
   *   >>> use App\\Models\\Inventory;
   *   >>> Inventory::where('quantity', '<', 0)->count();
   *   Expected: 0 (no negative stock!)
   *
   * ──── 5. Verify Prometheus received k6 metrics ────
   *   curl 'http://localhost:9090/api/v1/query?query=k6_http_requests_total'
   *
   * ──── 6. Open Grafana ────
   *   http://localhost:3000
   *   Expected: Real-time dashboards showing test results
   */
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
