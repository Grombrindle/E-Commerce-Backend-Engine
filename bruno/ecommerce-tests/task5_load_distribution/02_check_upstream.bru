meta {
  name: Check X-Upstream Header
  type: http
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

script:post-response {
  const upstream = res.getHeaders()["x-upstream"] || res.getHeaders()["X-Upstream"];
  console.log("Server that handled this request:", upstream);

  // Track distribution across requests
  let counts = {};
  try {
    counts = JSON.parse(bru.getVar("upstream_counts") || "{}");
  } catch(e) {}

  const server = (upstream || "unknown").toString().split(":")[0];
  counts[server] = (counts[server] || 0) + 1;
  bru.setVar("upstream_counts", JSON.stringify(counts));
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("X-Upstream header is present", function() {
    const upstream = res.getHeaders()["x-upstream"] || res.getHeaders()["X-Upstream"];
    expect(upstream).to.not.be.undefined;
    console.log("Upstream server:", upstream);
  });
}
