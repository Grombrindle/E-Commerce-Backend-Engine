meta {
  name: 2. Login (if registration fails)
  type: http
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{rate_user_email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body.token) {
    bru.setVar("rate_token", res.body.token);
  }
}

tests {
  test("Login succeeded (200) or user already exists (422 is expected)", function() {
    const status = res.getStatus();
    expect(status === 200 || status === 422).to.be.true;
  });
}
