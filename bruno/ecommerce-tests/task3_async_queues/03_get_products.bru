meta {
  name: Get Products
  type: http
}

get {
  url: {{base_url}}/products
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{async_token}}
}

script:post-response {
  const productId = res.body.data?.[0]?.id || res.body[0]?.id || res.body.id;
  if (productId) {
    bru.setVar("async_product_id", productId.toString());
  }
}

assert {
  res.status: eq 200
}
