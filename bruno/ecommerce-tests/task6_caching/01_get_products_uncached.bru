meta {
  name: 1. Get Products (Cold Cache — First Request)
  type: http
}

get {
  url: {{base_url}}/products?page=1&per_page=10
  body: none
  auth: none
}

script:pre-request {
  // Record start time — this request should hit the database (uncached)
  const startTime = Date.now();
  bru.setVar("task6_start_time", startTime.toString());
}

script:post-response {
  const startTime = parseInt(bru.getVar("task6_start_time") || "0");
  const duration = Date.now() - startTime;

  // Save duration for comparison
  bru.setVar("task6_first_call_ms", duration.toString());

  // Extract first product ID for subsequent requests
  const body = res.getBody();
  if (body.data && body.data.data && body.data.data.length > 0) {
    bru.setVar("cached_product_id", body.data.data[0].id.toString());
  }

  console.log("📊 FIRST CALL (cold cache): " + duration + "ms — expect 30-100ms (DB query)");
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response body contains products", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
  });
}
